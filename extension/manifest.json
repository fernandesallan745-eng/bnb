{
  "manifest_version": 3,
  "name": "Handsfree: Voice & Webcam-Based Browsing",
  "short_name": "Handsfree",
  "version": "1.0.0",
  "description": "Assistive handsfree web browsing on any website. Control cursor with head or hand movements, navigate with voice commands, and dictate into search bars.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Handsfree Controller",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "tracker.html",
        "tracker.js",
        "tracker.css",
        "overlay.css",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
